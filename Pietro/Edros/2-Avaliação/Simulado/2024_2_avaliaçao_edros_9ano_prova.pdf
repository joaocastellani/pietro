         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Funny comic strip. Money or passion? Two salaryman or job seeker having a conversation and discussion about employment, wealth, career opportunity, and happiness. </rdf:li>
            </rdf:Alt>
         </dc:description>
